# ── 数据库 ───────────────────────────────────────────────
# compose 内部网络访问，host 用 service 名 db
DATABASE_URL="postgresql://postgres:CHANGE_ME@db:5432/udes1gn?schema=public"
DB_PASSWORD="CHANGE_ME"

# ── 认证（Auth.js / NextAuth v5）─────────────────────────
# 生成：openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME"
# 生产填 https://你的域名；本地填 http://localhost:3000
NEXTAUTH_URL="https://YOUR_DOMAIN"

# ── 应用 ─────────────────────────────────────────────────
NODE_ENV="production"
