# 复制为 .env.production 并填值（.env.production 已 gitignore，不入库）

# ── 域名（已解析到本服务器）──────────────────────────────
SITE_DOMAIN="your-domain.com"

# ── 数据库（compose 内部）────────────────────────────────
POSTGRES_USER="udes1gn"
POSTGRES_PASSWORD="CHANGE_ME_strong_password"
POSTGRES_DB="udes1gn"

# ── 认证（Auth.js）──────────────────────────────────────
# 生成：openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME"
NEXTAUTH_URL="https://your-domain.com"

# ── 首次部署管理员（seed 用，RUN_SEED=1 时生效）─────────
ADMIN_EMAIL="you@your-domain.com"
ADMIN_PASSWORD="CHANGE_ME_strong_admin_password"

# 首次部署设 1（建库+种子），之后改回 0 或删除
RUN_SEED="1"
